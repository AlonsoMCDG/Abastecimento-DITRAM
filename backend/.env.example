# --- CONFIGURAÇÕES DO BACKEND (Django) ---
# Perfis disponíveis: dev | validation | prod
#   dev        -> SQLite local, DEBUG ligado
#   validation -> PostgreSQL (Render), DEBUG desligado
#   prod       -> PostgreSQL (Render), DEBUG desligado
DJANGO_PROFILE=dev

# Em 'dev' pode omitir (o padrão é DEBUG=dev). Em validation/prod use DEBUG=False.
DEBUG=True

# OBRIGATÓRIA. Gere uma chave única por ambiente:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=sua_chave_secreta_gerada_localmente

# Em 'dev' pode omitir (fallback seguro: 127.0.0.1, localhost).
# Em validation/prod é OBRIGATÓRIA — o app se recusa a subir sem ela.
# Separe múltiplos hosts por vírgula.
ALLOWED_HOSTS=127.0.0.1,localhost

# Vazio = SQLite local. Em validation/prod use a Connection URL do
# PostgreSQL do Render (Internal Database URL).
DATABASE_URL=

# Origens do frontend que podem chamar a API (CORS) e que o Django
# aceita em redirects/forms (CSRF). localhost e 127.0.0.1 são origens
# DIFERENTES para o navegador — liste as duas se usar ambas.
# Em dev, se omitir, o fallback inclui http://localhost:5173 e http://127.0.0.1:5173.
# Em validation/prod é OBRIGATÓRIO apontar para a URL pública do frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exemplo de .env para o RENDER (validation/prod):
#   DJANGO_PROFILE=validation
#   DEBUG=False
#   SECRET_KEY=<chave-gerada>
#   ALLOWED_HOSTS=abastecimento-seme-api.onrender.com
#   DATABASE_URL=postgres://... (Internal Database URL do Render)
#   CORS_ALLOWED_ORIGINS=https://abastecimento-seme-app.onrender.com
#   CSRF_TRUSTED_ORIGINS=https://abastecimento-seme-app.onrender.com